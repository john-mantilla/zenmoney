# ==========================================
# ZenMoney — Template de Variables de Entorno
# Copia este archivo a `.env` e ingresa los valores reales.
# ==========================================

# Supabase backend (Públicas en cliente móvil / web; protegidas por RLS en Postgres)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxx

# Monitoreo de Excepciones y Telemetría
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/yyyyyy

# Nivel de Logs (debug | info | warn | error)
LOG_LEVEL=info

# ==========================================
# NOTA DE SEGURIDAD (SECRETOS DEL SERVIDOR):
# Las claves de IA (Google Gemini) y servicios de correo (Resend)
# NUNCA deben configurarse como EXPO_PUBLIC_ en este archivo.
# Se configuran de forma segura y cifrada en Supabase Edge Functions:
#   supabase secrets set GEMINI_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
#   supabase secrets set RESEND_API_KEY="re_xxxxxxxxxxxxxx"
# ==========================================
